;
; EkranKurtarVDD.inf - Ekran Kurtar sanal ekran surucusu (IddCx, UMDF 2)
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=EkranKurtarVDD.cat
DriverVer=10/18/2026,1.3.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=EkVdd_Install, Root\EkranKurtarVDD

[SourceDisksFiles]
EkranKurtarVDD.dll=1

[SourceDisksNames]
1=%DiskName%

[DestinationDirs]
UMDriverCopy=13 ; surucu deposundan calisir

[UMDriverCopy]
EkranKurtarVDD.dll

; =================== Kurulum

[EkVdd_Install.NT]
CopyFiles=UMDriverCopy

[EkVdd_Install.NT.hw]
AddReg=EkVdd_HardwareDeviceSettings

[EkVdd_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "EkranKurtarVDDGroup"
; SYSTEM, Yoneticiler ve LocalService tam erisim; oturum acmis kullanici okuma/yazma
; (Ekran Kurtar yonetici olmadan da sanal monitor ekleyip kaldirabilsin diye)
HKR,, "Security", , "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;LS)(A;;GRGW;;;IU)"

[EkVdd_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[EkVdd_Install.NT.Wdf]
UmdfService=EkranKurtarVDD,EkranKurtarVDD_Install
UmdfServiceOrder=EkranKurtarVDD
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled

[EkranKurtarVDD_Install]
UmdfLibraryVersion=2.25.0
ServiceBinary=%13%\EkranKurtarVDD.dll
UmdfExtensions=IddCx0102

[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

; =================== Metinler

[Strings]
ManufacturerName="Ekran Kurtar"
DiskName="Ekran Kurtar Virtual Display Installation Disk"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="Ekran Kurtar Virtual Display"

REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
