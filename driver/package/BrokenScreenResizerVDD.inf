;
; BrokenScreenResizerVDD.inf - Broken Screen Resizer sanal ekran surucusu (IddCx, UMDF 2)
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=BrokenScreenResizerVDD.cat
DriverVer=10/18/2026,2.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=BsrVdd_Install, Root\BrokenScreenResizerVDD

[SourceDisksFiles]
BrokenScreenResizerVDD.dll=1

[SourceDisksNames]
1=%DiskName%

[DestinationDirs]
UMDriverCopy=13 ; surucu deposundan calisir

[UMDriverCopy]
BrokenScreenResizerVDD.dll

; =================== Kurulum

[BsrVdd_Install.NT]
CopyFiles=UMDriverCopy

[BsrVdd_Install.NT.hw]
AddReg=BsrVdd_HardwareDeviceSettings

[BsrVdd_HardwareDeviceSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "BrokenScreenResizerVDDGroup"
; SYSTEM, Yoneticiler ve LocalService tam erisim; oturum acmis kullanici okuma/yazma
; (Broken Screen Resizer yonetici olmadan da sanal monitor ekleyip kaldirabilsin diye)
HKR,, "Security", , "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;LS)(A;;GRGW;;;IU)"

[BsrVdd_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[BsrVdd_Install.NT.Wdf]
UmdfService=BrokenScreenResizerVDD,BrokenScreenResizerVDD_Install
UmdfServiceOrder=BrokenScreenResizerVDD
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled

[BrokenScreenResizerVDD_Install]
UmdfLibraryVersion=2.25.0
ServiceBinary=%13%\BrokenScreenResizerVDD.dll
UmdfExtensions=IddCx0102

[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

; =================== Metinler

[Strings]
ManufacturerName="Broken Screen Resizer"
DiskName="Broken Screen Resizer Virtual Display Installation Disk"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="Broken Screen Resizer Virtual Display"

REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
